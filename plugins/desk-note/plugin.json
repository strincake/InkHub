{
  "api_version": 1,
  "id": "desk-note",
  "name": "便签",
  "version": "1.1.0",
  "description": "管理多张便签，实时预览，逐张设置标题与字号。上下键翻阅，确认键切换明暗。",
  "entry": "main.py",
  "triggers": {
    "startup": true,
    "interval_seconds": 30,
    "keys": true,
    "actions": [
      {
        "id": "next-note",
        "label": "换一条便签"
      },
      {
        "id": "reset",
        "label": "回到第一张"
      }
    ]
  },
  "settings": [
    {
      "key": "document",
      "label": "便签列表",
      "type": "json",
      "default": {},
      "host_ui": false
    },
    {
      "key": "active_note",
      "label": "当前便签",
      "type": "text",
      "default": "",
      "host_ui": false
    },
    {
      "key": "title",
      "label": "屏幕标题",
      "type": "text",
      "default": "给今天留一点空间",
      "host_ui": false
    },
    {
      "key": "notes",
      "label": "旧版便签内容（兼容读取）",
      "type": "textarea",
      "default": "先完成最重要的一件事。\n站起来，喝一杯水。\n这块屏幕，也可以有你的新玩法。",
      "host_ui": false
    },
    {
      "key": "theme",
      "label": "画面颜色",
      "type": "select",
      "options": [
        "浅色",
        "深色"
      ],
      "default": "浅色"
    },
    {
      "key": "refresh_seconds",
      "label": "多久更新一次（秒）",
      "type": "number",
      "min": 5,
      "max": 3600,
      "default": 30
    },
    {
      "key": "show_clock",
      "label": "显示电脑本地时间",
      "type": "boolean",
      "default": true,
      "host_ui": false
    }
  ],
  "homepage": "home.html",
  "navigation_title": "便签"
}
